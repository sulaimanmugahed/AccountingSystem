# Base path of the .NET API. Leave as /api to use the Vite dev-server proxy
# (see VITE_API_PROXY_TARGET) or set an absolute URL, e.g. http://localhost:5074/api
VITE_API_BASE_URL=/api

# Where the Vite dev server proxies /api requests when NOT running in mock mode.
VITE_API_PROXY_TARGET=http://localhost:5074

# Run the whole UI against the bundled in-browser mock API (no .NET required).
# `npm run dev:mock` sets this automatically.
VITE_USE_MOCK=false
